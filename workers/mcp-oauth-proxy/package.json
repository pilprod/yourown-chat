{
  "name": "@yourown-chat/mcp-oauth-proxy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --conditions=workerd,worker,browser --target=es2022 --external:cloudflare:* --outfile=dist/worker.js",
