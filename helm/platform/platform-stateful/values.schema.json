{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/pilprod/yourown-chat/helm/platform/platform-stateful/values.schema.json",
  "title": "platform-stateful values contract",
  "description": "Typed capability contract for a workload with stable identity or retained persistent volumes, including the narrow typed layer-four transport exposure. Unknown properties are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workload",
    "image",
    "container",
    "runtime",
    "identity",
    "secrets",
    "network",
    "service",
    "persistence",
    "layer4Exposure",
    "observability"
  ],
  "definitions": {
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,51}[a-z0-9])?$"
    },
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "optionalKebab": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)?$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-docker\\.pkg\\.dev/[a-z][a-z0-9-]{4,28}[a-z0-9]/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$"
    },
    "cpuQuantity": {
      "type": "string",
      "pattern": "^([0-9]+m|[0-9]+(\\.[0-9]+)?)$"
    },
    "optionalCpuQuantity": {
      "type": "string",
      "pattern": "^(([0-9]+m|[0-9]+(\\.[0-9]+)?))?$"
    },
    "memoryQuantity": {
      "type": "string",
      "pattern": "^[0-9]+(Ki|Mi|Gi|k|M|G)?$"
    },
    "sizeQuantity": {
      "type": "string",
      "pattern": "^[0-9]+(Mi|Gi)$"
    },
    "portName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,13}[a-z0-9])?$"
    },
    "portNumber": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "protocol": {
      "type": "string",
      "enum": [
        "TCP",
        "UDP"
      ]
    },
    "httpPath": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9._~/-]*$"
    },
    "hostname": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
    },
    "gsaEmail": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com)?$"
    },
    "gcpProject": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9])?$"
    },
    "ipv4": {
      "type": "string",
      "pattern": "^(([0-9]{1,3}\\.){3}[0-9]{1,3})?$"
    },
    "cidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
    },
    "purpose": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "labelMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "additionalProperties": false,
      "patternProperties": {
        "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$": {
          "type": "string",
          "pattern": "^([A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?)?$"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "httpGet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "$ref": "#/definitions/httpPath"
            }
          }
        },
        "exec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      },
      "required": [
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ],
      "not": {
        "required": [
          "httpGet",
          "exec"
        ]
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "port"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/portName"
        },
        "port": {
          "$ref": "#/definitions/portNumber"
        },
        "protocol": {
          "$ref": "#/definitions/protocol"
        }
      }
    },
    "rulePort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "protocol": {
          "$ref": "#/definitions/protocol"
        }
      }
    },
    "ingressPeer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sameNamespace": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "namespace": {
          "$ref": "#/definitions/kebab"
        },
        "podLabels": {
          "$ref": "#/definitions/labelMap"
        },
        "ingressController": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "cidr": {
          "$ref": "#/definitions/cidr"
        }
      },
      "oneOf": [
        {
          "required": [
            "sameNamespace"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "namespace"
                ]
              },
              {
                "required": [
                  "ingressController"
                ]
              },
              {
                "required": [
                  "cidr"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "namespace"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "sameNamespace"
                ]
              },
              {
                "required": [
                  "ingressController"
                ]
              },
              {
                "required": [
                  "cidr"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "ingressController"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "sameNamespace"
                ]
              },
              {
                "required": [
                  "namespace"
                ]
              },
              {
                "required": [
                  "cidr"
                ]
              },
              {
                "required": [
                  "podLabels"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "cidr"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "sameNamespace"
                ]
              },
              {
                "required": [
                  "namespace"
                ]
              },
              {
                "required": [
                  "ingressController"
                ]
              },
              {
                "required": [
                  "podLabels"
                ]
              }
            ]
          }
        }
      ]
    },
    "egressPeer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sameNamespace": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "namespace": {
          "$ref": "#/definitions/kebab"
        },
        "podLabels": {
          "$ref": "#/definitions/labelMap"
        },
        "cidr": {
          "$ref": "#/definitions/cidr"
        },
        "internet": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "metadataServer": {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "sameNamespace"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "namespace"
                ]
              },
              {
                "required": [
                  "cidr"
                ]
              },
              {
                "required": [
                  "internet"
                ]
              },
              {
                "required": [
                  "metadataServer"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "namespace"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "sameNamespace"
                ]
              },
              {
                "required": [
                  "cidr"
                ]
              },
              {
                "required": [
                  "internet"
                ]
              },
              {
                "required": [
                  "metadataServer"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "cidr"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "sameNamespace"
                ]
              },
              {
                "required": [
                  "namespace"
                ]
              },
              {
                "required": [
                  "internet"
                ]
              },
              {
                "required": [
                  "metadataServer"
                ]
              },
              {
                "required": [
                  "podLabels"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "internet"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "sameNamespace"
                ]
              },
              {
                "required": [
                  "namespace"
                ]
              },
              {
                "required": [
                  "cidr"
                ]
              },
              {
                "required": [
                  "metadataServer"
                ]
              },
              {
                "required": [
                  "podLabels"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "metadataServer"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "sameNamespace"
                ]
              },
              {
                "required": [
                  "namespace"
                ]
              },
              {
                "required": [
                  "cidr"
                ]
              },
              {
                "required": [
                  "internet"
                ]
              },
              {
                "required": [
                  "podLabels"
                ]
              }
            ]
          }
        }
      ]
    },
    "ingressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "from"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,38}[a-z0-9])?$"
        },
        "purpose": {
          "$ref": "#/definitions/purpose"
        },
        "from": {
          "$ref": "#/definitions/ingressPeer"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/rulePort"
          }
        }
      }
    },
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "to",
        "ports"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,38}[a-z0-9])?$"
        },
        "purpose": {
          "$ref": "#/definitions/purpose"
        },
        "to": {
          "$ref": "#/definitions/egressPeer"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/rulePort"
          }
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/dnsLabel"
        },
        "partOf": {
          "$ref": "#/definitions/optionalKebab"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "$ref": "#/definitions/imageDigest"
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ports",
        "health",
        "resources",
        "runAsUser",
        "tmpSizeLimit",
        "writableVolumes",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "command": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "env": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]{0,127}$": {
              "type": "string",
              "maxLength": 4096
            }
          }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/port"
          }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port",
            "readiness",
            "liveness"
          ],
          "properties": {
            "port": {
              "$ref": "#/definitions/portName"
            },
            "startup": {
              "$ref": "#/definitions/probe"
            },
            "readiness": {
              "$ref": "#/definitions/probe"
            },
            "liveness": {
              "$ref": "#/definitions/probe"
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "$ref": "#/definitions/cpuQuantity"
                },
                "memory": {
                  "$ref": "#/definitions/memoryQuantity"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "memory"
              ],
              "properties": {
                "cpu": {
                  "$ref": "#/definitions/optionalCpuQuantity"
                },
                "memory": {
                  "$ref": "#/definitions/memoryQuantity"
                }
              }
            }
          }
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 65535
        },
        "tmpSizeLimit": {
          "$ref": "#/definitions/sizeQuantity"
        },
        "writableVolumes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "mountPath",
              "sizeLimit"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?$",
                "not": {
                  "enum": [
                    "tmp",
                    "data",
                    "platform-secrets"
                  ]
                }
              },
              "mountPath": {
                "type": "string",
                "pattern": "^/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
                "not": {
                  "pattern": "^/(tmp|proc|sys|dev|etc|var/run/secrets)(/.*)?$"
                }
              },
              "sizeLimit": {
                "$ref": "#/definitions/sizeQuantity"
              }
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "paused",
        "priorityClass",
        "disruptionBudget"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "paused": {
          "type": "boolean"
        },
        "priorityClass": {
          "type": "string",
          "enum": [
            "development",
            "production"
          ]
        },
        "nodePool": {
          "$ref": "#/definitions/optionalKebab"
        },
        "disruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "minAvailable"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "googleServiceAccount"
      ],
      "properties": {
        "googleServiceAccount": {
          "$ref": "#/definitions/gsaEmail"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "mountPath",
        "files"
      ],
      "properties": {
        "project": {
          "$ref": "#/definitions/gcpProject"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/var/run/secrets/[a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?$"
        },
        "files": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "secret",
              "file"
            ],
            "properties": {
              "secret": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,255}$"
              },
              "file": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "version": {
                "type": "string",
                "pattern": "^(latest|[1-9][0-9]{0,9})$"
              }
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingress",
        "egress"
      ],
      "properties": {
        "clusterDNSIP": {
          "$ref": "#/definitions/ipv4"
        },
        "ingress": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/ingressRule"
          }
        },
        "egress": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/egressRule"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrics"
      ],
      "properties": {
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "port",
            "path"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "$ref": "#/definitions/portName"
            },
            "path": {
              "$ref": "#/definitions/httpPath"
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "size",
        "mountPath",
        "accessMode",
        "retain"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string",
          "pattern": "^([1-9][0-9]{0,3}Gi|[1-9][0-9]{0,5}Mi)$"
        },
        "storageClass": {
          "$ref": "#/definitions/optionalKebab"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "not": {
            "pattern": "^/(tmp|proc|sys|dev|etc|var/run/secrets)(/.*)?$"
          }
        },
        "accessMode": {
          "type": "string",
          "enum": [
            "ReadWriteOnce",
            "ReadWriteOncePod"
          ]
        },
        "retain": {
          "type": "boolean"
        }
      }
    },
    "layer4Exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "externalTrafficPolicy",
        "ports"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "reservedAddress": {
          "$ref": "#/definitions/ipv4"
        },
        "externalTrafficPolicy": {
          "type": "string",
          "enum": [
            "Local"
          ]
        },
        "ports": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "port",
              "protocol"
            ],
            "properties": {
              "name": {
                "$ref": "#/definitions/portName"
              },
              "port": {
                "$ref": "#/definitions/portNumber"
              },
              "protocol": {
                "$ref": "#/definitions/protocol"
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "reservedAddress"
        ],
        "properties": {
          "reservedAddress": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$"
          },
          "ports": {
            "minItems": 1
          }
        }
      }
    }
  }
}
