{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/pilprod/yourown-chat/helm/platform/platform-job/values.schema.json",
  "title": "platform-job values contract",
  "description": "Typed capability contract for a bounded Job or CronJob. Completion status replaces service probes; no ingress is accepted. Unknown properties are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workload",
    "image",
    "container",
    "job",
    "runtime",
    "identity",
    "secrets",
    "network"
  ],
  "definitions": {
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,51}[a-z0-9])?$"
    },
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "optionalKebab": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)?$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-docker\\.pkg\\.dev/[a-z][a-z0-9-]{4,28}[a-z0-9]/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$"
    },
    "cpuQuantity": {
      "type": "string",
      "pattern": "^([0-9]+m|[0-9]+(\\.[0-9]+)?)$",
      "not": {
        "pattern": "^0*(\\.0*)?m?$"
      }
    },
    "optionalCpuQuantity": {
      "type": "string",
      "pattern": "^(([0-9]+m|[0-9]+(\\.[0-9]+)?))?$",
      "not": {
        "pattern": "^0+(\\.0*)?m?$"
      }
    },
    "memoryQuantity": {
      "type": "string",
      "pattern": "^[0-9]+(Ki|Mi|Gi|k|M|G)?$",
      "not": {
        "pattern": "^0+(Ki|Mi|Gi|k|M|G)?$"
      }
    },
    "sizeQuantity": {
      "type": "string",
      "pattern": "^[0-9]+(Mi|Gi)$"
    },
    "portName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,13}[a-z0-9])?$"
    },
    "portNumber": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "protocol": {
      "type": "string",
      "enum": [
        "TCP",
        "UDP"
      ]
    },
    "httpPath": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9._~/-]*$"
    },
    "hostname": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
    },
    "gsaEmail": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com)?$"
    },
    "gcpProject": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9])?$"
    },
    "ipv4": {
      "type": "string",
      "pattern": "^(([0-9]{1,3}\\.){3}[0-9]{1,3})?$"
    },
    "cidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
    },
    "purpose": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "labelMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "additionalProperties": false,
      "patternProperties": {
        "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$": {
          "type": "string",
          "pattern": "^([A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?)?$"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "httpGet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "$ref": "#/definitions/httpPath"
            }
          }
        },
        "exec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      },
      "required": [
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ],
      "not": {
        "required": [
          "httpGet",
          "exec"
        ]
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "port"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/portName"
        },
        "port": {
          "$ref": "#/definitions/portNumber"
        },
        "protocol": {
          "$ref": "#/definitions/protocol"
        }
      }
    },
    "rulePort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "protocol": {
          "$ref": "#/definitions/protocol"
        }
      }
    },
    "egressPeer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sameNamespace": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "namespace": {
          "$ref": "#/definitions/kebab"
        },
        "podLabels": {
          "$ref": "#/definitions/labelMap"
        },
        "cidr": {
          "$ref": "#/definitions/cidr"
        },
        "internet": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "metadataServer": {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "sameNamespace"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "namespace"
                ]
              },
              {
                "required": [
                  "cidr"
                ]
              },
              {
                "required": [
                  "internet"
                ]
              },
              {
                "required": [
                  "metadataServer"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "namespace"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "sameNamespace"
                ]
              },
              {
                "required": [
                  "cidr"
                ]
              },
              {
                "required": [
                  "internet"
                ]
              },
              {
                "required": [
                  "metadataServer"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "cidr"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "sameNamespace"
                ]
              },
              {
                "required": [
                  "namespace"
                ]
              },
              {
                "required": [
                  "internet"
                ]
              },
              {
                "required": [
                  "metadataServer"
                ]
              },
              {
                "required": [
                  "podLabels"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "internet"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "sameNamespace"
                ]
              },
              {
                "required": [
                  "namespace"
                ]
              },
              {
                "required": [
                  "cidr"
                ]
              },
              {
                "required": [
                  "metadataServer"
                ]
              },
              {
                "required": [
                  "podLabels"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "metadataServer"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "sameNamespace"
                ]
              },
              {
                "required": [
                  "namespace"
                ]
              },
              {
                "required": [
                  "cidr"
                ]
              },
              {
                "required": [
                  "internet"
                ]
              },
              {
                "required": [
                  "podLabels"
                ]
              }
            ]
          }
        }
      ]
    },
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "to",
        "ports"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,38}[a-z0-9])?$"
        },
        "purpose": {
          "$ref": "#/definitions/purpose"
        },
        "to": {
          "$ref": "#/definitions/egressPeer"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/rulePort"
          }
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,48}[a-z0-9])?$"
        },
        "partOf": {
          "$ref": "#/definitions/optionalKebab"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "$ref": "#/definitions/imageDigest"
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources",
        "runAsUser",
        "tmpSizeLimit",
        "writableVolumes",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "command": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "env": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]{0,127}$": {
              "type": "string",
              "maxLength": 4096
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "$ref": "#/definitions/cpuQuantity"
                },
                "memory": {
                  "$ref": "#/definitions/memoryQuantity"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "memory"
              ],
              "properties": {
                "cpu": {
                  "$ref": "#/definitions/optionalCpuQuantity"
                },
                "memory": {
                  "$ref": "#/definitions/memoryQuantity"
                }
              }
            }
          }
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 65535
        },
        "tmpSizeLimit": {
          "$ref": "#/definitions/sizeQuantity"
        },
        "writableVolumes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "mountPath",
              "sizeLimit"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?$",
                "not": {
                  "enum": [
                    "tmp",
                    "data",
                    "platform-secrets"
                  ]
                }
              },
              "mountPath": {
                "type": "string",
                "pattern": "^/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
                "not": {
                  "pattern": "^/(tmp|proc|sys|dev|etc|var/run/secrets)(/.*)?$"
                }
              },
              "sizeLimit": {
                "$ref": "#/definitions/sizeQuantity"
              }
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priorityClass"
      ],
      "properties": {
        "priorityClass": {
          "type": "string",
          "enum": [
            "development",
            "production"
          ]
        },
        "nodePool": {
          "$ref": "#/definitions/optionalKebab"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "googleServiceAccount"
      ],
      "properties": {
        "googleServiceAccount": {
          "$ref": "#/definitions/gsaEmail"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "mountPath",
        "files"
      ],
      "properties": {
        "project": {
          "$ref": "#/definitions/gcpProject"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/var/run/secrets/[a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?$"
        },
        "files": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "secret",
              "file"
            ],
            "properties": {
              "secret": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,255}$"
              },
              "file": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "version": {
                "type": "string",
                "pattern": "^(latest|[1-9][0-9]{0,9})$"
              }
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clusterDNSIP",
        "egress"
      ],
      "properties": {
        "clusterDNSIP": {
          "type": "string",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$"
        },
        "egress": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/egressRule"
          }
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "suspend",
        "backoffLimit",
        "activeDeadlineSeconds",
        "ttlSecondsAfterFinished",
        "restartPolicy",
        "concurrencyPolicy",
        "startingDeadlineSeconds",
        "successfulJobsHistoryLimit",
        "failedJobsHistoryLimit"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Job",
            "CronJob"
          ]
        },
        "schedule": {
          "type": "string",
          "pattern": "^(([0-9*,/-]+)\\s+){4}[0-9*,/-]+$|^$"
        },
        "suspend": {
          "type": "boolean"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800
        },
        "restartPolicy": {
          "type": "string",
          "enum": [
            "OnFailure",
            "Never"
          ]
        },
        "concurrencyPolicy": {
          "type": "string",
          "enum": [
            "Forbid",
            "Replace"
          ]
        },
        "startingDeadlineSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 86400
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "CronJob"
          }
        }
      },
      "then": {
        "required": [
          "schedule"
        ],
        "properties": {
          "schedule": {
            "type": "string",
            "pattern": "^(([0-9*,/-]+)\\s+){4}[0-9*,/-]+$"
          }
        }
      }
    }
  }
}
