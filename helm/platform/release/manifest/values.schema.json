{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/pilprod/yourown-chat/helm/platform/release/manifest/values.schema.json",
  "title": "Service release manifest",
  "description": "helm/release.yaml in a service repository: the service-owned list of platform-profile release wrappers and the typed release-parameter bindings of their workloads. No pipeline, Skaffold or Kubernetes content is accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "wrappers"],
  "definitions": {
    "kebab": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,38}[a-z0-9])?$" }
  },
  "properties": {
    "global": { "type": "object", "additionalProperties": false },
    "apiVersion": { "type": "string", "enum": ["platform.yourown.chat/v1"] },
    "kind": { "type": "string", "enum": ["ReleaseManifest"] },
    "wrappers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "namespace", "workloads"],
        "properties": {
          "name": { "$ref": "#/definitions/kebab" },
          "path": { "type": "string", "pattern": "^helm/[a-z0-9]([-a-z0-9]{0,38}[a-z0-9])?$" },
          "namespace": { "$ref": "#/definitions/kebab" },
          "workloads": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 16,
            "additionalProperties": false,
            "patternProperties": {
              "^[a-z0-9]([-a-z0-9]{0,38}[a-z0-9])?$": {
                "type": "object",
                "additionalProperties": false,
                "required": ["image"],
                "properties": {
                  "image": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?$" },
                  "identity": { "$ref": "#/definitions/kebab" }
                }
              }
            }
          }
        }
      }
    }
  }
}
