# Terraform / OpenTofu
**/.terraform/*
# Ignore transient per-module lock files, but KEEP the stack root lock files:
# HCP Terraform Stacks requires .terraform.lock.hcl committed at each stack root.
**/.terraform.lock.hcl
!/terraform/platform-gcp/.terraform.lock.hcl
!/terraform/app-gcp/.terraform.lock.hcl
!/terraform/cloudflare/.terraform.lock.hcl
!/terraform/agent-registry-gcp/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Secrets / local vars (commit *.example templates instead)
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
*-credentials.json
*.key.json
service-account*.json

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
.codex/*
!.codex/config.toml

# JavaScript / TypeScript
**/node_modules/
**/.npm/
**/.pnpm-store/
**/coverage/
**/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.coverage
**/htmlcov/
**/*.egg-info/

# Local application configuration and build output
.env
.env.*
!.env.example
**/dist/
**/build/
